{
  "name": "@unidock/web",
  "version": "0.1.0",
  "private": true,
  "description": "UniDock minimal local-first web app.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:pwa": "node scripts/check-pwa.mjs",
    "test": "pnpm run build && node --test test/backup.test.mjs",
    "verify": "pnpm run test && pnpm run check:pwa"
  },
  "dependencies": {
    "@unidock/content": "workspace:*",
    "@unidock/reader": "workspace:*",
    "@unidock/rss": "workspace:*",
    "@unidock/storage": "workspace:*"
  }
}
